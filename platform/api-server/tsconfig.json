{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": true,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@chattermark/core": ["../../packages/core/src/index.ts"],
      "@chattermark/core/*": ["../../packages/core/src/*"],
      "@chattermark/services": ["../services/src/index.ts"],
      "@chattermark/services/*": ["../services/src/*"],
      "@chattermark/adapters": ["../adapters/src/index.ts"],
      "@chattermark/adapters/*": ["../adapters/src/*"],
      "@services/*": ["../services/src/*"],
      "@adapters/*": ["../adapters/src/*"],
      "@api/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
